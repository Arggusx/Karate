# Conexao com o Neon. Copie para .env.local e preencha.
# ATENCAO: sem o prefixo VITE_ de proposito — variaveis VITE_ vao para o
# bundle do navegador, o que exporia a credencial do banco publicamente.
DATABASE_URL="postgresql://usuario:senha@host.neon.tech/neondb?sslmode=require"

# Segredo de assinatura da sessao (JWT). Minimo 32 caracteres.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""
